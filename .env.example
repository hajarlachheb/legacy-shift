# ── LLM Provider ──────────────────────────────────────────
# Leave all keys empty to use FREE local model (Ollama). Install: https://ollama.com then run: ollama run llama3.2
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AZURE_API_KEY=
AZURE_API_BASE=

# Default model (use ollama/llama3.2 for free local, or gpt-4o etc. when you have API keys)
DEFAULT_MODEL=gpt-4o

# Free local model (Ollama) — only used when no API keys are set or DEFAULT_MODEL starts with ollama/
OLLAMA_BASE_URL=http://localhost:11434

# ── pgvector (code-pattern store) ─────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=legacy_shift
POSTGRES_USER=legacy_shift
POSTGRES_PASSWORD=changeme

# ── Observability ─────────────────────────────────────────
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=legacy-shift
PHOENIX_ENDPOINT=http://localhost:6006

# ── General ───────────────────────────────────────────────
LOG_LEVEL=INFO
MAX_RETRIES=3
