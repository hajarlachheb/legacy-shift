# ── LLM Provider ──────────────────────────────────────────
OPENAI_API_KEY=sk-...
# Optional: use any LiteLLM-supported provider
ANTHROPIC_API_KEY=
AZURE_API_KEY=
AZURE_API_BASE=

# Default model used for all pipeline steps (LiteLLM format)
DEFAULT_MODEL=gpt-4o

# ── pgvector (code-pattern store) ─────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=legacy_shift
POSTGRES_USER=legacy_shift
POSTGRES_PASSWORD=changeme

# ── Observability ─────────────────────────────────────────
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=legacy-shift
PHOENIX_ENDPOINT=http://localhost:6006

# ── General ───────────────────────────────────────────────
LOG_LEVEL=INFO
MAX_RETRIES=3
